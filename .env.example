DATABASE_URL=postgresql://postgres:your_password@localhost:5432/controle_financeiro
# Operator-only demo provisioning; use the intended target database, never commit its credentials.
# DEMO_DATABASE_URL=postgresql://user:password@your-neon-host/database?sslmode=verify-full
# Exclusive platform administrator: immutable UUID of your existing account.
# Set locally with: npm run admin:configure -- seu@email.com
# PLATFORM_ADMIN_USER_ID=
# Optional separate database for integration tests (requires CREATE SCHEMA permission).
# TEST_DATABASE_URL=postgresql://postgres:your_password@localhost:5432/controle_financeiro_test
# Public origin: required for transactional emails in production (HTTPS).
# Leave unset for local development via localhost or the computer's Wi-Fi IP.
# APP_ORIGIN=https://financeiro.exemplo.com
# Required in production for email links (HTTPS). Never derive public links from Host.
# RESEND_API_KEY=re_your_api_key
# Sender address on a verified Resend domain.
# RESEND_FROM_EMAIL=Saldo da Casa <acesso@exemplo.com>
# Sandbox without a domain: set this to the email associated with your Resend account.
# All verification/reset emails are redirected here; tokens still belong to the original account.
# While set, the sender is automatically Saldo da Casa <onboarding@resend.dev>.
# RESEND_SANDBOX_TO=seu-email-da-conta-resend@example.com
# After verifying your domain, remove RESEND_SANDBOX_TO and configure RESEND_FROM_EMAIL.
# The Vercel Production build refuses this override. Use a separate test DB in Preview.
# Development without RESEND_API_KEY prints verification/reset links in the terminal.
# Vercel uses its protected x-vercel-forwarded-for automatically (VERCEL=1).
# Elsewhere, only behind an ingress that OVERWRITES this header and blocks direct access.
# Never enable for an Internet-accessible Next.js server without that ingress.
# TRUSTED_CLIENT_IP_HEADER=x-forwarded-for
